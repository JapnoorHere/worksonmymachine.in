# --- This Is Fine™ environment -------------------------------------------
# Everything here is OPTIONAL. With none of it set, the site still runs end to
# end: submissions fall back to an in-memory queue that survives exactly as long
# as your dev server does. Which is honestly on brand.

# MongoDB connection string. Local or Atlas, we're not picky.
#   local:  mongodb://127.0.0.1:27017/thisisfine
#   atlas:  mongodb+srv://user:pass@cluster.mongodb.net/thisisfine
MONGODB_URI=

# Password for the /admin review queue.
# If you leave this blank, the default is "thisisfine" and that is a you problem.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SECRET=

# Secret used to sign real visitor session cookies (signup/login). Any long
# random string — different from ADMIN_SECRET, so one can't forge the other.
# Unset in production: accounts are refused, not defaulted (same rule as
# ADMIN_PASSWORD).
AUTH_SECRET=
